{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelgym.local/schemas/price-catalog-v1.json",
  "title": "PixelGym frozen provider price catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "entries"],
  "properties": {
    "schema_version": {"const": "pixelgym-price-catalog-v1"},
    "catalog_version": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model", "input_usd_per_million_tokens", "output_usd_per_million_tokens"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "input_usd_per_million_tokens": {"type": "number", "minimum": 0},
          "output_usd_per_million_tokens": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
