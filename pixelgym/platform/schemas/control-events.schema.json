{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelgym.local/schemas/control-events-v1.json",
  "oneOf": [
    {"$ref": "#/$defs/approval"},
    {"$ref": "#/$defs/deployment"},
    {"$ref": "#/$defs/audit"}
  ],
  "$defs": {
    "approval": {"type": "object", "additionalProperties": false, "required": ["approval_id", "candidate_id", "actor", "reason", "gate_report_sha256", "policy_id", "created_at_utc"], "properties": {"approval_id": {"type": "string", "minLength": 1}, "candidate_id": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "gate_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "policy_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "created_at_utc": {"type": "string", "format": "date-time"}}},
    "deployment": {"type": "object", "additionalProperties": false, "required": ["deployment_id", "candidate_id", "policy_id", "action", "actor", "reason", "created_at_utc", "generation"], "properties": {"deployment_id": {"type": "string", "minLength": 1}, "candidate_id": {"type": "string", "minLength": 1}, "policy_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "action": {"enum": ["deploy", "rollback"]}, "actor": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "created_at_utc": {"type": "string", "format": "date-time"}, "generation": {"type": "integer", "minimum": 1}}},
    "audit": {"type": "object", "additionalProperties": false, "required": ["event_id", "event_type", "actor", "subject_id", "details_json", "details", "created_at_utc"], "properties": {"event_id": {"type": "string", "minLength": 1}, "event_type": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "subject_id": {"type": "string", "minLength": 1}, "details_json": {"type": "string"}, "details": {"type": "object"}, "created_at_utc": {"type": "string", "format": "date-time"}}}
  }
}
