FROM python:3.12.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements/mlflow-py312.lock /tmp/mlflow-py312.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/mlflow-py312.lock
RUN groupadd --system --gid 10001 mlflow \
    && useradd --system --uid 10001 --gid mlflow --home-dir /home/mlflow --create-home mlflow
WORKDIR /home/mlflow
USER mlflow:mlflow
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000"]
