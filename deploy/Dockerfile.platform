FROM python:3.12.11-slim-bookworm
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY pyproject.toml README.md ./
COPY requirements/platform-py312.lock ./requirements/platform-py312.lock
COPY pixelgym/platform/dependency_lock.py ./pixelgym/platform/dependency_lock.py
RUN python pixelgym/platform/dependency_lock.py --repository-root /app
RUN pip install --no-cache-dir --require-hashes -r requirements/platform-py312.lock
COPY pixelgym ./pixelgym
COPY flows ./flows
COPY config ./config
COPY scripts ./scripts
COPY --chmod=0755 deploy/platform-entrypoint.sh /usr/local/bin/platform-entrypoint.sh
COPY artifacts/grounding-dataset.jsonl artifacts/grounding-overlays.jsonl artifacts/grounding-predictions.jsonl ./artifacts/
COPY artifacts/grounding ./artifacts/grounding
RUN pip install --no-cache-dir --no-deps .
CMD ["/usr/local/bin/platform-entrypoint.sh"]
