{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelgym.local/schemas/promotion-gates-v1.json",
  "title": "PixelGym promotion gate policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_version", "minimum_accuracy",
    "maximum_cost_usd_per_100", "maximum_provider_latency_p95_ms",
    "minimum_measured_count", "required_dataset_fingerprint",
    "required_scorer_version", "required_target_semantics", "dirty_code_allowed",
    "confidence_bound_required", "confidence_level", "synthetic_only"
  ],
  "properties": {
    "schema_version": {"const": "pixelgym-promotion-gate-policy-v1"},
    "policy_version": {"type": "string", "minLength": 1},
    "minimum_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "maximum_cost_usd_per_100": {"type": "number", "minimum": 0},
    "maximum_provider_latency_p95_ms": {"type": "number", "minimum": 0},
    "minimum_measured_count": {"type": "integer", "minimum": 1},
    "required_dataset_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "required_scorer_version": {"type": "string", "minLength": 1},
    "required_target_semantics": {"type": "string", "minLength": 1},
    "dirty_code_allowed": {"type": "boolean"},
    "confidence_bound_required": {"type": "boolean"},
    "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "synthetic_only": {"type": "boolean"}
  }
}
